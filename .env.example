# ===========================================
# Remisiones Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Environment: development | production | test
NODE_ENV=development

# Port for the HTTP server (default: 3000)
PORT=3000

# MongoDB connection string (REQUIRED)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGO_URI=

# JWT Access Token Secret (REQUIRED, min 32 characters)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=

# JWT Refresh Token Secret (REQUIRED, min 32 characters)
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=

# JWT Access Token expiration (default: 15m)
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token expiration (default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# Allowed CORS origins, comma-separated (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Rate limiting: window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting: max requests per window (default: 300)
RATE_LIMIT_MAX=300

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info
