{
	"name": "remisiones-backend",
	"version": "1.0.0",
	"description": "Backend para generador de remisiones - Node/Express/Bun, Clean Architecture, MongoDB",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"format": "biome format .",
		"prepare": "husky"
	},
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.0",
		"express-mongo-sanitize": "^2.2.0",
		"express-rate-limit": "^7.4.0",
		"helmet": "^7.1.0",
		"hpp": "^0.2.3",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.7.0",
		"morgan": "^1.10.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/hpp": "^0.2.6",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.7.4",
		"bun-types": "^1.4.2",
		"husky": "^9.1.7",
		"typescript": "^5.6.2"
	}
}
